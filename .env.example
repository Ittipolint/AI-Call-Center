MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=replace-minio-password
N8N_ENABLED=false
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_WS_BASE_URL=ws://localhost:8080

