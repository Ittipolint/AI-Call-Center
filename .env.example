APP_ENV=development
JWT_SECRET=replace-with-a-long-random-secret
ADMIN_EMAIL=admin@example.local
ADMIN_PASSWORD=change-me-before-use
INTERNAL_SERVICE_TOKEN=replace-with-a-long-random-token
MAX_UPLOAD_BYTES=26214400
